# Server only. Copy to .env.local; never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
BRAVE_SEARCH_API_KEY=
# SearchApi.io (different from SerpApi.com)
SEARCHAPI_API_KEY=
# Optional SerpApi.com alternative
SERPAPI_API_KEY=

# Recommended harness; requires the drawing Docker image.
ALONGSIDE_HARNESS=shell
ALONGSIDE_DATA_DIR=.local/lessons
# Set colima only when the host Docker socket is unavailable.
ALONGSIDE_CONTAINER_CLI=docker
